        {
          "nome": "Queijo Parmesão ralado",
          "quantidade": 50,
          "unidade": "g"
        },
        {
          "nome": "Orégano seco",
          "quantidade": 1,
          "unidade": "pitada"
        }
      ],
      "modoDePreparo": [
        {
          "passo": 1,
          "titulo": "Preaquecer o forno",
          "instrucao": "Preaqueça o forno na temperatura máxima (250°C a 280°C) por pelo menos 20 minutos."
        },
        {
          "passo": 2,
          "titulo": "Montar a base",
          "instrucao": "Abra a massa em uma assadeira e espalhe o molho de tomate uniformemente, deixando 1 cm de borda."
        },
        {
          "passo": 3,
          "titulo": "Adicionar os queijos",
          "instrucao": "Distribua a muçarela, espalhe pequenas porções de gorgonzola e catupiry, e finalize polvilhando o parmesão."
        },
        {
          "passo": 4,
          "titulo": "Assar",
          "instrucao": "Leve ao forno por 12 a 15 minutos ou até as bordas dourarem e o queijo derreter completamente."
        }
      ]
    },

