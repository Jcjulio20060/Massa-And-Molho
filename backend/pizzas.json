      "ingredientes": [
        {
          "nome": "Massa para pizza artesanal",
          "quantidade": 1,
          "unidade": "disco (35cm)"
        },
        {
          "nome": "Molho de tomate caseiro",
          "quantidade": 150,
          "unidade": "g"
        },
        {
          "nome": "Queijo Muçarela ralado",
          "quantidade": 200,
          "unidade": "g"
        },
        {
          "nome": "Queijo Gorgonzola esfarelado",
          "quantidade": 80,
          "unidade": "g"
        },
        {
          "nome": "Requeijão tipo Catupiry",
          "quantidade": 100,
          "unidade": "g"
